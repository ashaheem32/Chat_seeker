# ============================================================================
# ChatLens - Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# ---- Project ----------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=chatlens
POSTGRES_PASSWORD=chatlens_dev_password
POSTGRES_DB=chatlens
POSTGRES_HOST=postgres                 # use 'localhost' if running backend outside docker
POSTGRES_PORT=5432

# Constructed by docker-compose, but set here for local (non-docker) dev.
DATABASE_URL=postgresql+asyncpg://chatlens:chatlens_dev_password@localhost:5432/chatlens

# ---- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Backend (FastAPI) ------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-please-use-a-real-random-32-byte-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max upload size in bytes (default 50MB - chat exports can be large)
MAX_UPLOAD_SIZE_BYTES=52428800

# ---- AI / LLM Providers -----------------------------------------------------
# Used for chat content analysis. Configure whichever provider(s) you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default provider for analysis tasks
LLM_PROVIDER=anthropic                 # anthropic | openai
LLM_MODEL=claude-sonnet-4-6

# ---- Embeddings (for pgvector semantic search) ------------------------------
EMBEDDING_PROVIDER=openai              # openai | voyage | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Frontend (Next.js) -----------------------------------------------------
# Public vars are exposed to the browser - never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ChatLens
